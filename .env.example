# --- Database ---
DATABASE_URL="postgresql://quiz:quiz@localhost:5432/quiz?schema=public"

# --- Redis ---
REDIS_HOST="localhost"
REDIS_PORT=6379
# Managed Redis (optional): set a password/TLS, or a full URL that wins over host/port.
# REDIS_USERNAME=""
# REDIS_PASSWORD=""
# REDIS_TLS="false"
# REDIS_URL="rediss://:password@host:6379"

# --- API ---
API_PORT=4000
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
# Comma-separated phone numbers auto-promoted to admin on login (any accepted format).
ADMIN_PHONES="09120000000"

# OTP
OTP_TTL_SECONDS=300
# When set, this fixed code is used instead of a random one (handy for local dev).
# Leave empty in production to generate random 6-digit codes.
OTP_MOCK_CODE="000000"
# Abuse guards (SMS costs money). Min seconds between sends per phone, and max sends
# per phone per hour. Set either to 0 to disable (handy in dev).
OTP_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5

# --- SMS (Kavenegar) ---
# While the key is the sample placeholder below, SMS is mocked: codes are logged, not sent.
# Replace with a real key to actually deliver via Kavenegar VerifyLookup.
KAVENEGAR_API_KEY="kavenegar-sample-api-key"
KAVENEGAR_OTP_TEMPLATE="quiz-otp"
KAVENEGAR_WELCOME_TEMPLATE="quiz-welcome"
KAVENEGAR_DISCOUNT_TEMPLATE="quiz-discount"

# --- Game platform (shop-access quests) ---
# Origin of the external game platform + secret service key. Used by shop-access
# ACTION quests to grant a player (by phone) access to a SKU. Leave unset to disable.
GAME_SERVICE_BASE_URL="https://platform.example.com"
GAME_SERVICE_KEY=""

# --- Web ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Frontend origin(s) allowed by API CORS (comma-separated).
CORS_ORIGIN="http://localhost:3000"
