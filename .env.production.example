# Production environment — copy to .env.production and fill in REAL values.
# Never commit the filled-in file. Prefer your orchestrator's secret store.
#
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# --- Reverse proxy (Caddy) ---
# The public domain. Caddy auto-provisions a Let's Encrypt cert for it —
# DNS must already point at this server's IP before the stack starts.
DOMAIN=quiz.example.com

# --- Postgres (compose builds DATABASE_URL from these) ---
POSTGRES_USER=quiz
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=quiz

# If you point at a managed Postgres instead, set the full URL on the api service:
#   DATABASE_URL=postgresql://user:pass@host:5432/db?schema=public&sslmode=require

# --- Redis (now supports auth + TLS) ---
REDIS_PASSWORD=CHANGE_ME_strong_redis_password
# For a managed Redis, set these on the api service instead of host/port:
#   REDIS_URL=rediss://:password@host:6379     # rediss:// = TLS
#   REDIS_TLS=true                             # or force TLS on host/port

# --- API ---
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_EXPIRES_IN=7d
# Comma-separated phones auto-promoted to admin on login.
ADMIN_PHONES=09120000000
OTP_TTL_SECONDS=300
# MUST be empty in production — a value here makes OTP a fixed code (login wide open).
OTP_MOCK_CODE=
# SMS abuse guards: min seconds between sends per phone, max sends per phone per hour.
OTP_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5

# --- SMS (Kavenegar) — server IP must be whitelisted; templates must be APPROVED ---
KAVENEGAR_API_KEY=CHANGE_ME_real_kavenegar_key
KAVENEGAR_OTP_TEMPLATE=quiz-otp
KAVENEGAR_WELCOME_TEMPLATE=quiz-welcome
KAVENEGAR_DISCOUNT_TEMPLATE=quiz-discount

# --- Game platform (shop-access quests) — secret key stays server-side ---
GAME_SERVICE_BASE_URL=https://platform.example.com
GAME_SERVICE_KEY=CHANGE_ME_game_service_key

# --- CORS: the PUBLIC web origin(s), comma-separated. Should match https://$DOMAIN ---
CORS_ORIGIN=https://quiz.example.com

# --- Web (BUILD-TIME) — inlined into the bundle; rebuild the image to change.
#     Should be https://$DOMAIN/api ---
NEXT_PUBLIC_API_URL=https://quiz.example.com/api
