// Quiz App — MVP schema
// Design principle: ScoreEvent is an append-only ledger. Redis sorted sets
// are a rebuildable cache of it. weekKey (ISO week, e.g. "2026-W28") scopes
// weekly vs. overall as a filter, not separate tables.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & acquisition
// ---------------------------------------------------------------------------

model User {
  id          String   @id @default(cuid())
  phone       String   @unique
  displayName String? // the player's full name (shown on leaderboards)
  age         Int?
  isAdmin     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // referral: who invited this user
  referredById String?
  referredBy   User?   @relation("UserReferrals", fields: [referredById], references: [id])
  referrals    User[]  @relation("UserReferrals")

  acquisitionSource  AcquisitionSource?
  rounds             Round[]
  scoreEvents        ScoreEvent[]
  prizeAwards        PrizeAward[]
  ownedReferral      Referral?
  referralAttributed ReferralAttribution?
  questCollections   QuestCollection[]
  leagueRewards      LeagueReward[]
  roundGrants        RoundGrant[]

  @@index([referredById])
}

model AcquisitionSource {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  referralCode String?
  landingPath  String?
  capturedAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Quiz content & gameplay
// ---------------------------------------------------------------------------

// Admin-configurable game settings. Single row (id = "singleton").
model GameConfig {
  id                  String   @id @default("singleton")
  gameDurationSeconds Int      @default(60) // total time per round (the "game timer")
  roundBonus          Int      @default(0) // awarded once on finishing a round (0 = off)
  referralBonus       Int      @default(0) // credited to a referrer when their invitee finishes their 1st round
  // How each 12-question page is composed: [{difficulty, count}, ...] across difficulty 1-3, counts sum to PAGE_SIZE (12).
  difficultyMix Json     @default("[{\"difficulty\":1,\"count\":4},{\"difficulty\":2,\"count\":4},{\"difficulty\":3,\"count\":4}]")
  // Points awarded per correct answer, per question difficulty: [{difficulty, points}, ...].
  pointsPerDifficulty Json @default("[{\"difficulty\":1,\"points\":5},{\"difficulty\":2,\"points\":10},{\"difficulty\":3,\"points\":20}]")
  updatedAt           DateTime @updatedAt
}

model Question {
  id           String   @id @default(cuid())
  text         String
  choices      Json // string[]
  correctIndex Int
  difficulty   Int      @default(1)
  category     String?
  isActive     Boolean  @default(true)
  // Static random key for efficient random sampling: pick a random pivot and range-scan
  // `rand` via the index instead of `ORDER BY RANDOM()` (which sorts the whole table).
  rand         Float    @default(dbgenerated("random()"))
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roundQuestions RoundQuestion[]

  @@index([isActive, difficulty, rand])
}

enum RoundStatus {
  IN_PROGRESS
  FINISHED
  ABANDONED
}

model Round {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     RoundStatus @default(IN_PROGRESS)
  // Denormalized running total of this round's ScoreEvents, incremented in the same
  // transaction as each award. Lets the hot answer path skip a re-aggregate query.
  score      Int         @default(0)
  startedAt  DateTime    @default(now())
  finishedAt DateTime?
  // League this round was played in (stamped at start). Drives the per-league round cap.
  leagueId   String?
  league     League?     @relation(fields: [leagueId], references: [id], onDelete: SetNull)

  questions   RoundQuestion[]
  scoreEvents ScoreEvent[]

  @@index([userId])
  @@index([leagueId])
}

// Extra playable rounds a user earned within a league (append-only ledger).
// Allowance for a league = League.roundAllowance + sum(RoundGrant.amount) for that user+league.
model RoundGrant {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leagueId  String
  league    League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  amount    Int // rounds granted (>0)
  questId   String? // source quest, if granted by a quest collection
  createdAt DateTime @default(now())

  @@index([userId, leagueId])
}

model RoundQuestion {
  id            String    @id @default(cuid())
  roundId       String
  round         Round     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question  @relation(fields: [questionId], references: [id])
  answeredIndex Int?
  isCorrect     Boolean?
  answeredAt    DateTime?

  @@index([roundId])
}

// ---------------------------------------------------------------------------
// Scoring — append-only ledger
// ---------------------------------------------------------------------------

enum ScoreReason {
  CORRECT_ANSWER
  ROUND_BONUS
  REFERRAL_CREDIT
  ADMIN_ADJUSTMENT
  QUEST_REWARD
  LEAGUE_REWARD
}

model ScoreEvent {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roundId   String?
  round     Round?      @relation(fields: [roundId], references: [id])
  points    Int
  reason    ScoreReason
  weekKey   String // ISO week, e.g. "2026-W28"
  createdAt DateTime    @default(now())

  // [userId, createdAt] serves both per-user lookups and windowed aggregates
  // (quest challenge progress); [createdAt] serves cross-user league-standings windows.
  @@index([userId, createdAt])
  @@index([weekKey])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Prizes
// ---------------------------------------------------------------------------

enum PrizeAwardStatus {
  PENDING
  FULFILLED
  CANCELLED
}

model Prize {
  id          String  @id @default(cuid())
  name        String
  description String?
  tier        Int     @default(1)
  rankFrom    Int
  rankTo      Int
  weekScope   Boolean @default(true)

  awards PrizeAward[]
}

model PrizeAward {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  prizeId   String
  prize     Prize            @relation(fields: [prizeId], references: [id])
  weekKey   String
  status    PrizeAwardStatus @default(PENDING)
  awardedAt DateTime         @default(now())

  @@unique([userId, prizeId, weekKey])
  @@index([weekKey])
}

// ---------------------------------------------------------------------------
// Referrals
// ---------------------------------------------------------------------------

model Referral {
  id          String   @id @default(cuid())
  code        String   @unique
  ownerUserId String   @unique
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  uses        Int      @default(0)
  createdAt   DateTime @default(now())

  attributions ReferralAttribution[]
}

model ReferralAttribution {
  id           String   @id @default(cuid())
  referralCode String
  referral     Referral @relation(fields: [referralCode], references: [code])
  newUserId    String   @unique
  newUser      User     @relation(fields: [newUserId], references: [id], onDelete: Cascade)
  attributedAt DateTime @default(now())

  @@index([referralCode])
}

// ---------------------------------------------------------------------------
// Quests (achievements / collectible tasks)
// ---------------------------------------------------------------------------

enum QuestType {
  CHALLENGE // earn `targetScore` gameplay points before `deadline`, then collect `rewardScore`
  ACTION // external task (follow page, invite friend…); collect once its verify condition is met
}

// How an ACTION quest is verified before it becomes collectible.
enum QuestVerify {
  NONE // honor-system: collectible while active (e.g. follow us on Instagram)
  REFERRAL_SIGNUPS // needs `verifyTarget` invited users to have signed in (referredById set)
}

model Quest {
  id          String    @id @default(cuid())
  title       String
  icon        String    @default("🎯") // emoji or short glyph shown on the card
  description String?
  type        QuestType @default(ACTION)
  rewardScore Int       @default(0) // added to the user's total (QUEST_REWARD ScoreEvent) on collect
  rewardRounds Int      @default(0) // extra playable rounds granted (RoundGrant) on collect, for the active league
  targetScore Int? // CHALLENGE only: gameplay points to earn within the window to unlock
  actionUrl   String? // ACTION only: link to the external task
  verify      QuestVerify @default(NONE) // ACTION only: auto-verify condition
  verifyTarget Int? // ACTION+verify: threshold (e.g. required referral signups)
  minDwellSeconds Int   @default(0) // ACTION+honor-system: seconds the player must wait after opening the task link before Collect unlocks (0 = instant)

  // Shop-access ACTION: when shopGameCode is set, clicking calls the external game
  // platform to grant the player (by phone) access to a SKU, then awards the reward.
  shopGameCode String? // e.g. "little_guardians"
  shopSkuKind  String? // e.g. "map"
  shopSkuId    String? // e.g. "full_game"
  startsAt    DateTime  @default(now())
  deadline    DateTime? // collect-by time; null = no expiry
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  collections QuestCollection[]
}

model QuestCollection {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId      String
  quest        Quest    @relation(fields: [questId], references: [id], onDelete: Cascade)
  awardedScore Int
  collectedAt  DateTime @default(now())

  @@unique([userId, questId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Leagues (admin-defined leaderboard windows) + rank rewards
// ---------------------------------------------------------------------------

model League {
  id        String    @id @default(cuid())
  title     String
  startsAt  DateTime
  endsAt    DateTime
  isOverall Boolean   @default(false) // the campaign; only awards PS5 to #1
  frozenAt  DateTime? // set once ended + rewards generated
  // Base number of rounds each player may play within this league's window.
  roundAllowance Int  @default(3)
  // Regular (non-overall) leagues bind to the overall campaign they belong to,
  // so the previous-leagues UI can group weekly leagues under their campaign.
  parentLeagueId String?
  parentLeague    League?  @relation("LeagueParent", fields: [parentLeagueId], references: [id], onDelete: SetNull)
  childLeagues    League[] @relation("LeagueParent")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  rewards     LeagueReward[]
  rounds      Round[]
  roundGrants RoundGrant[]

  @@index([isOverall])
  @@index([parentLeagueId])
}

enum LeagueRewardStatus {
  PENDING
  COLLECTED
}

// Per-player reward for their rank in a frozen league. Shown as a collectible in Quests.
model LeagueReward {
  id                    String             @id @default(cuid())
  leagueId              String
  league                League             @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  userId                String
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  rank                  Int
  basePoints            Int                @default(0) // always credited on collect
  physicalPrize         String? // "Tablet", "PlayStation 5"
  optionPoints          Int? // optional prize: points alternative
  optionDiscountPercent Int? // optional prize: discount alternative
  status                LeagueRewardStatus @default(PENDING)
  chosenOption          String? // "POINTS" | "DISCOUNT"
  discountCode          String? // assigned from the pool on collect
  collectedAt           DateTime?
  createdAt             DateTime           @default(now())

  @@unique([leagueId, userId])
  @@index([userId])
}

// Admin-uploaded discount-code pool (imported from Excel/CSV), drawn from when a player picks a discount reward.
model DiscountCode {
  id               String    @id @default(cuid())
  code             String    @unique
  type             String // e.g. "Percentage", "Cashback" — free-text label from the import sheet
  percent          Int
  title            String // human-readable name shown in the admin fulfillment view
  assignedToUserId String?
  assignedAt       DateTime?

  @@index([percent, assignedToUserId])
}
